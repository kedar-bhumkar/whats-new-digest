{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "What's New items",
  "type": "object",
  "required": ["lastUpdated", "days"],
  "additionalProperties": false,
  "properties": {
    "lastUpdated": { "type": "string", "minLength": 1 },
    "days": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "picks", "notable"],
        "additionalProperties": false,
        "properties": {
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "picks": { "type": "array", "items": { "$ref": "#/$defs/item" } },
          "notable": { "type": "array", "items": { "$ref": "#/$defs/item" } }
        }
      }
    }
  },
  "$defs": {
    "unit": { "type": "number", "minimum": 0, "maximum": 1 },
    "item": {
      "type": "object",
      "required": ["id", "title", "url", "source", "category", "why", "rank", "scores", "flags"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https?://" },
        "source": { "type": "string", "enum": ["web", "github", "reddit", "youtube", "email", "x"] },
        "category": { "type": "string", "minLength": 1 },
        "why": { "type": "string", "maxLength": 200 },
        "rank": { "$ref": "#/$defs/unit" },
        "scores": {
          "type": "object",
          "required": ["significance", "relevance", "actionability", "novelty"],
          "additionalProperties": false,
          "properties": {
            "significance": { "$ref": "#/$defs/unit" },
            "relevance": { "$ref": "#/$defs/unit" },
            "actionability": { "$ref": "#/$defs/unit" },
            "novelty": { "$ref": "#/$defs/unit" }
          }
        },
        "also": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": ["title", "url", "source"],
            "additionalProperties": false,
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "url": { "type": "string", "pattern": "^https?://" },
              "source": { "type": "string", "enum": ["web", "github", "reddit", "youtube", "email", "x"] }
            }
          }
        },
        "flags": {
          "type": "object",
          "required": ["low_confidence", "hype_p"],
          "additionalProperties": false,
          "properties": {
            "low_confidence": { "type": "boolean" },
            "hype_p": { "$ref": "#/$defs/unit" }
          }
        }
      }
    }
  }
}
